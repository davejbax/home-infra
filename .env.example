# Copy to .env and fill in. .env is gitignored and loaded automatically by mise.

# --- Pulumi state backend: Cloudflare R2 -----------------------------------
# <bucket>   the R2 bucket holding this stack's state
# <account>  your Cloudflare account ID (the R2 endpoint's leading label)
PULUMI_BACKEND_URL="s3://<bucket>?endpoint=<account>.r2.cloudflarestorage.com&region=auto"

# R2 API token credentials, from Cloudflare dashboard -> R2 -> Manage API tokens.
# The Pulumi S3 backend reads them under their AWS names.
AWS_ACCESS_KEY_ID="<r2-access-key-id>"
AWS_SECRET_ACCESS_KEY="<r2-secret-access-key>"
AWS_REGION="auto"

# --- Secrets encryption -----------------------------------------------------
# A DIY backend has no key management of its own, so Pulumi encrypts secrets
# (the cluster CAs, talosconfig and kubeconfig) with this passphrase. Losing it
# makes the state unreadable -- keep it in your password manager.
PULUMI_CONFIG_PASSPHRASE="<a-long-random-passphrase>"

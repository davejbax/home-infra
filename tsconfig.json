{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022"],
    "module": "node18",
    "rootDir": ".",
    "outDir": "bin",
    "sourceMap": true,
    "strict": true,
    "noUnusedLocals": true,
    "noImplicitReturns": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["index.ts"]
}
